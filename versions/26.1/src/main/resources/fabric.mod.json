{
    "schemaVersion": 1,
    "id": "skyziyou",
    "version": "1.0.0",
    "name": "Skyziyou",
    "description": "Hypixel SkyBlock utility mod: radial command wheel, auto party invites and custom chat rules.",
    "authors": [
        "orchidsziyou"
    ],
    "license": "MIT",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "value": "com.skyziyou.SkyziyouMod",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "skyziyou.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.19.0",
        "fabric-api": "*",
        "fabric-language-kotlin": ">=1.13.0",
        "minecraft": "~26.1",
        "java": ">=25"
    }
}
